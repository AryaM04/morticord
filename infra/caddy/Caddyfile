# Caddy configuration for the production stack with direct TLS
# (PROXY_MODE=direct). Caddy reads every value from the environment (see
# docker-compose.yml and .env.example). The site part is in site.caddy.
#
# TLS_MODE is empty on a real server: Caddy gets a Let's Encrypt
# certificate. For a local test, set TLS_MODE=internal: Caddy uses its own
# test certificate authority.

{
	email {$ACME_EMAIL}
	# Limits against slow clients (slowloris). The body time is not limited:
	# a large attachment upload on a slow line can take many minutes. The
	# API server limits the time of one request to 5 minutes.
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

{$DOMAIN} {
	tls {$TLS_MODE}

	import /etc/caddy/site.caddy
}
