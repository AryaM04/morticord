{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The permissions of the main window: the app commands, event listen, and opening http and https links in the system browser. Nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-desktop-init",
    "allow-secure-get",
    "allow-secure-set",
    "allow-secure-delete",
    "allow-check-server",
    "allow-set-server-url",
    "allow-link-preview-fetch",
    "allow-notify",
    "allow-set-push-to-talk",
    "allow-set-voice-state",
    "allow-set-close-to-tray",
    "allow-set-unread-badge",
    "allow-check-update",
    "allow-install-update",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
